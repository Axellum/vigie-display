# yamllint: catches real errors (syntax, duplicate keys, inconsistent indentation) in the
# ESPHome YAML, which is full of tags (!include, !lambda) and one-line C++ lambdas.
extends: relaxed

rules:
  line-length: disable
  new-lines: disable      # CRLF in a Windows working tree, LF in git
  truthy: disable         # `on:` is a GitHub Actions key
  document-start: disable
